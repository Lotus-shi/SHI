/* 空状态组件 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}
.empty__icon {
  font-size: 100rpx;
}
.empty__text {
  margin-top: 24rpx;
  color: #999;
  font-size: 28rpx;
}
.empty__btn {
  margin-top: 40rpx;
  padding: 16rpx 64rpx;
  background: #07c160;
  color: #fff;
  font-size: 28rpx;
  border-radius: 40rpx;
}
