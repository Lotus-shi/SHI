/* 商品卡片样式（卡片内 px 用 rpx，背景白、圆角、阴影） */
.goods-card {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}

/* 图片区域 */
.goods-card__img-wrap {
  position: relative;
  width: 100%;
  height: 340rpx;
}
.goods-card__img {
  width: 100%;
  height: 100%;
  background: #f2f2f2;
}
/* 角标 */
.goods-card__tag {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  padding: 4rpx 12rpx;
  font-size: 20rpx;
  color: #fff;
  background: #ff4949;
  border-radius: 8rpx;
}
.goods-card__tag--new {
  left: auto;
  right: 16rpx;
  background: #07c160;
}

/* 内容区 */
.goods-card__body {
  padding: 16rpx;
}
.goods-card__name {
  font-size: 28rpx;
  color: #333;
  line-height: 1.4;
  height: 76rpx;
  overflow: hidden;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2; /* 最多两行 */
}
.goods-card__price-row {
  display: flex;
  align-items: baseline;
  margin-top: 12rpx;
}
.goods-card__price {
  color: #ff4949;
}
.goods-card__price-symbol {
  font-size: 24rpx;
}
.goods-card__price-num {
  font-size: 36rpx;
  font-weight: 600;
}
.goods-card__price-original {
  margin-left: 12rpx;
  font-size: 24rpx;
  color: #999;
  text-decoration: line-through;
}
.goods-card__meta {
  display: flex;
  justify-content: space-between;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #999;
}
