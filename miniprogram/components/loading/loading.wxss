/* 加载状态组件 */
.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}
.loading__spinner {
  width: 56rpx;
  height: 56rpx;
  border: 4rpx solid #e8e8e8;
  border-top-color: #07c160;
  border-radius: 50%;
  animation: loading-rotate 0.8s linear infinite;
}
.loading__text {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #999;
}

@keyframes loading-rotate {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}
