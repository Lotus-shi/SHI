/* ===== 配送追踪页样式 ===== */
.logistics {
  min-height: 100vh;
  background: #f7f7f7;
  padding-bottom: 60rpx;
}

/* 当前状态头部 */
.logistics__head {
  display: flex;
  align-items: center;
  padding: 40rpx 32rpx;
  background: linear-gradient(135deg, #07c160, #05a04e);
}
.logistics__head-icon {
  font-size: 72rpx;
}
.logistics__head-info {
  margin-left: 24rpx;
}
.logistics__head-status {
  font-size: 36rpx;
  font-weight: 600;
  color: #fff;
}
.logistics__head-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

/* 配送员卡片 */
.logistics__courier {
  margin: 20rpx 24rpx 0;
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  display: flex;
  align-items: center;
}
.logistics__courier-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #e8f8ef;
  color: #07c160;
  font-size: 36rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.logistics__courier-info {
  flex: 1;
  margin-left: 20rpx;
}
.logistics__courier-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}
.logistics__courier-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #999;
  display: flex;
  flex-direction: column;
}
.logistics__call-btn {
  padding: 16rpx 28rpx;
  border: 1rpx solid #07c160;
  color: #07c160;
  font-size: 26rpx;
  border-radius: 36rpx;
  flex-shrink: 0;
}

/* 时间轴 */
.logistics__timeline {
  margin: 20rpx 24rpx 0;
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx 24rpx;
}
.logistics__node {
  display: flex;
  position: relative;
  padding-bottom: 36rpx;
}
.logistics__node:last-child {
  padding-bottom: 0;
}
/* 竖线连接 */
.logistics__node::before {
  content: '';
  position: absolute;
  left: 12rpx;
  top: 28rpx;
  bottom: -8rpx;
  width: 2rpx;
  background: #eee;
}
.logistics__node:last-child::before {
  display: none;
}
.logistics__node-dot {
  width: 26rpx;
  height: 26rpx;
  border-radius: 50%;
  background: #ddd;
  flex-shrink: 0;
  z-index: 1;
}
.logistics__node--current .logistics__node-dot {
  background: #07c160;
  box-shadow: 0 0 0 6rpx rgba(7, 193, 96, 0.15);
}
.logistics__node-body {
  margin-left: 20rpx;
}
.logistics__node-text {
  font-size: 28rpx;
  color: #666;
}
.logistics__node-text--current {
  color: #07c160;
  font-weight: 600;
}
.logistics__node-time {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #999;
}

/* 订单号 */
.logistics__order-no {
  margin: 24rpx 24rpx 0;
  font-size: 24rpx;
  color: #999;
  text-align: center;
}

/* 模拟配送端按钮（开发模式） */
.logistics__mock {
  margin: 24rpx 24rpx 0;
  padding: 24rpx;
  background: #fff8e6;
  color: #b8860b;
  font-size: 26rpx;
  text-align: center;
  border-radius: 16rpx;
  border: 1rpx dashed #e6c56a;
}

/* 加载中 */
.logistics__loading {
  padding-top: 200rpx;
  text-align: center;
  color: #999;
  font-size: 28rpx;
}
