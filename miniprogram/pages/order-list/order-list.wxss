/* ===== 订单列表页样式 ===== */
.olist {
  min-height: 100vh;
  background: #f7f7f7;
  padding-bottom: 40rpx;
}

/* Tab 栏 */
.olist__tabs {
  position: sticky;
  top: 0;
  z-index: 10;
  display: flex;
  background: #fff;
  padding: 0 10rpx;
}
.olist__tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #666;
  position: relative;
}
.olist__tab--active {
  color: #07c160;
  font-weight: 600;
}
.olist__tab--active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  background: #07c160;
  border-radius: 4rpx;
}

/* 空状态 */
.olist__empty {
  padding-top: 160rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.olist__empty-icon {
  font-size: 100rpx;
}
.olist__empty-text {
  margin-top: 24rpx;
  color: #999;
  font-size: 28rpx;
}

/* 订单卡片 */
.olist__list {
  padding: 20rpx 24rpx 0;
}
.olist__card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}
.olist__card-head {
  display: flex;
  justify-content: space-between;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f2f2f2;
}
.olist__card-no {
  font-size: 24rpx;
  color: #999;
}
.olist__card-status {
  font-size: 26rpx;
  color: #333;
}
.olist__card-status--pay {
  color: #ff4949;
}

/* 商品缩略图 */
.olist__goods {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
}
.olist__goods-img {
  width: 110rpx;
  height: 110rpx;
  border-radius: 12rpx;
  background: #f2f2f2;
  margin-right: 16rpx;
}
.olist__goods-more {
  width: 110rpx;
  height: 110rpx;
  border-radius: 12rpx;
  background: #f7f7f7;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #999;
}

/* 卡片底部 */
.olist__card-foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.olist__card-amount-label {
  font-size: 24rpx;
  color: #999;
}
.olist__card-amount-num {
  margin-left: 8rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #ff4949;
}
.olist__card-actions {
  display: flex;
}
.olist__btn {
  padding: 12rpx 32rpx;
  font-size: 26rpx;
  color: #666;
  border: 1rpx solid #ddd;
  border-radius: 32rpx;
  margin-left: 16rpx;
}
.olist__btn--primary {
  color: #fff;
  background: #07c160;
  border-color: #07c160;
}

/* 加载提示 */
.olist__load {
  padding: 24rpx 0;
  text-align: center;
  color: #999;
  font-size: 24rpx;
}
