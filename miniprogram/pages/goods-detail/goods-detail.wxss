/* ===== 商品详情页样式 ===== */
.detail {
  background: #f7f7f7;
  min-height: 100vh;
  padding-bottom: 140rpx;
}

/* 轮播 */
.detail__swiper {
  height: 750rpx;
  background: #fff;
}
.detail__swiper-img {
  width: 100%;
  height: 100%;
}

/* 信息区 */
.detail__info {
  background: #fff;
  padding: 24rpx;
}
.detail__price-row {
  display: flex;
  align-items: baseline;
}
.detail__price {
  color: #ff4949;
}
.detail__price-symbol {
  font-size: 28rpx;
}
.detail__price-num {
  font-size: 48rpx;
  font-weight: 700;
}
.detail__price-unit {
  font-size: 24rpx;
  color: #999;
  margin-left: 8rpx;
}
.detail__price-original {
  margin-left: 20rpx;
  font-size: 26rpx;
  color: #999;
  text-decoration: line-through;
}
.detail__name {
  margin-top: 16rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
  line-height: 1.5;
}
.detail__meta {
  margin-top: 12rpx;
  display: flex;
  font-size: 24rpx;
  color: #999;
}
.detail__meta text {
  margin-right: 24rpx;
}

/* 通用区块 */
.detail__section {
  background: #fff;
  margin-top: 20rpx;
  padding: 24rpx;
}
.detail__section-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.detail__section-label {
  font-size: 28rpx;
  color: #333;
}
.detail__section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

/* 数量步进器 */
.stepper {
  display: flex;
  align-items: center;
}
.stepper__btn {
  width: 56rpx;
  height: 56rpx;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #333;
  background: #fff;
}
.stepper__btn--disabled {
  color: #ccc;
}
.stepper__num {
  min-width: 72rpx;
  text-align: center;
  font-size: 30rpx;
}

/* 图文详情 */
.detail__goods-detail {
  overflow: hidden;
}
.detail__rich {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}

/* 底部操作栏（固定） */
.detail__footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 120rpx;
  background: #fff;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
}
.detail__footer-contact {
  width: 100rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.detail__footer-icon {
  font-size: 36rpx;
}
.detail__footer-text {
  font-size: 20rpx;
  color: #666;
}
.detail__footer-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  font-size: 30rpx;
  color: #fff;
  border-radius: 40rpx;
}
.detail__footer-btn--cart {
  background: #ffb300;
  margin-left: 16rpx;
}
.detail__footer-btn--buy {
  background: #07c160;
  margin-left: 16rpx;
}

/* 加载中 */
.detail-loading {
  padding-top: 200rpx;
  text-align: center;
  color: #999;
  font-size: 28rpx;
}
