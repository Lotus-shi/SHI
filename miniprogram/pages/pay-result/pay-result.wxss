/* ===== 支付结果页样式 ===== */
.result {
  min-height: 100vh;
  background: #fff;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 160rpx;
}
.result__icon {
  font-size: 140rpx;
}
.result__title {
  margin-top: 32rpx;
  font-size: 40rpx;
  font-weight: 600;
  color: #333;
}
.result__amount {
  margin-top: 20rpx;
  font-size: 56rpx;
  font-weight: 700;
  color: #ff4949;
}
.result__order-no {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #999;
}
.result__actions {
  margin-top: 100rpx;
  display: flex;
}
.result__btn {
  width: 240rpx;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  font-size: 30rpx;
  border-radius: 42rpx;
  border: 1rpx solid #ddd;
  color: #333;
  margin: 0 16rpx;
}
.result__btn--primary {
  background: #07c160;
  color: #fff;
  border-color: #07c160;
}
