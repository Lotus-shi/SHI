<!-- 首页 -->
<view class="page">
  <!-- 顶部搜索栏（固定） -->
  <view class="search-bar">
    <view class="search-bar__input-wrap">
      <input
        class="search-bar__input"
        placeholder="搜索新鲜果蔬"
        value="{{keyword}}"
        bindinput="onKeywordInput"
        bindconfirm="onSearch"
        confirm-type="search"
      />
    </view>
    <view class="search-bar__btn" bindtap="onSearch">搜索</view>
  </view>

  <!-- 轮播图（推荐位） -->
  <view class="banner-wrap" wx:if="{{banners.length}}">
    <swiper class="banner" autoplay circular interval="4000" indicator-dots indicator-color="rgba(255,255,255,.4)" indicator-active-color="#ffffff">
      <swiper-item wx:for="{{banners}}" wx:key="id" bindtap="onBannerTap" data-id="{{item.id}}">
        <image class="banner__img" src="{{item.image}}" mode="aspectFill" />
      </swiper-item>
    </swiper>
  </view>

  <!-- 分类九宫格 -->
  <view class="grid-panel" wx:if="{{categories.length}}">
    <view class="grid-panel__item" wx:for="{{categories}}" wx:key="id" bindtap="onCategoryTap" data-id="{{item.id}}">
      <view class="grid-panel__icon">{{item.iconChar}}</view>
      <view class="grid-panel__name">{{item.name}}</view>
    </view>
  </view>

  <!-- 热销商品横向滚动 -->
  <view class="section" wx:if="{{hotGoods.length}}">
    <view class="section__title">
      <text>🔥 热销推荐</text>
      <text class="section__more" bindtap="onMoreHot">查看更多 ></text>
    </view>
    <scroll-view class="hot-scroll" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="hot-scroll__inner">
        <view class="hot-card" wx:for="{{hotGoods}}" wx:key="id" bindtap="onBannerTap" data-id="{{item.id}}">
          <image class="hot-card__img" src="{{item.image}}" mode="aspectFill" lazy-load />
          <view class="hot-card__name">{{item.name}}</view>
          <view class="hot-card__price">¥{{item.price}}</view>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 商品瀑布流（两列） -->
  <view class="section">
    <view class="section__title"><text>全部商品</text></view>
    <view class="waterfall">
      <view class="waterfall__col">
        <goods-card wx:for="{{leftList}}" wx:key="id" goods="{{item}}" />
      </view>
      <view class="waterfall__col">
        <goods-card wx:for="{{rightList}}" wx:key="id" goods="{{item}}" />
      </view>
    </view>

    <!-- 空状态 -->
    <empty wx:if="{{ready && leftList.length === 0 && rightList.length === 0}}" icon="🍎" text="暂无商品" />

    <!-- 加载状态 -->
    <loading show="{{loading}}" text="加载中..." />
    <view class="load-more" wx:if="{{!hasMore && (leftList.length + rightList.length) > 0}}">
      <text>— 已经到底啦 —</text>
    </view>
  </view>
</view>
