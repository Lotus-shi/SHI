/* ===== 首页样式 ===== */
.page {
  min-height: 100vh;
  background: #f7f7f7;
  padding-bottom: 40rpx;
}

/* 搜索栏（固定在顶部） */
.search-bar {
  position: sticky;
  top: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #07c160;
}
.search-bar__input-wrap {
  flex: 1;
  background: #fff;
  border-radius: 32rpx;
  padding: 8rpx 24rpx;
}
.search-bar__input {
  height: 56rpx;
  font-size: 26rpx;
}
.search-bar__btn {
  margin-left: 20rpx;
  color: #fff;
  font-size: 28rpx;
}

/* 轮播图 */
.banner-wrap {
  margin: 20rpx 24rpx 0;
}
.banner {
  height: 300rpx;
  border-radius: 16rpx;
  overflow: hidden;
}
.banner__img {
  width: 100%;
  height: 100%;
}

/* 分类九宫格 */
.grid-panel {
  display: flex;
  flex-wrap: wrap;
  margin: 20rpx 24rpx 0;
  padding: 24rpx 0 8rpx;
  background: #fff;
  border-radius: 16rpx;
}
.grid-panel__item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 20rpx;
}
.grid-panel__icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #e8f8ef;
  color: #07c160;
  font-size: 36rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}
.grid-panel__name {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #333;
}

/* 区块标题 */
.section {
  margin-top: 20rpx;
}
.section__title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}
.section__more {
  font-size: 24rpx;
  font-weight: 400;
  color: #999;
}

/* 热销横向滚动 */
.hot-scroll {
  white-space: nowrap;
}
.hot-scroll__inner {
  display: inline-flex;
  padding: 0 24rpx;
}
.hot-card {
  width: 220rpx;
  margin-right: 20rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 16rpx;
  white-space: normal;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}
.hot-card__img {
  width: 100%;
  height: 200rpx;
  border-radius: 12rpx;
  background: #f2f2f2;
}
.hot-card__name {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.hot-card__price {
  margin-top: 8rpx;
  color: #ff4949;
  font-size: 30rpx;
  font-weight: 600;
}

/* 瀑布流两列 */
.waterfall {
  display: flex;
  padding: 0 24rpx;
}
.waterfall__col {
  flex: 1;
  min-width: 0;
}
.waterfall__col:first-child {
  margin-right: 20rpx;
}
.waterfall__col goods-card {
  display: block;
  margin-bottom: 20rpx;
}

/* 空状态与加载提示 */
.empty {
  padding: 80rpx 0;
  text-align: center;
  color: #999;
  font-size: 26rpx;
}
.load-more {
  padding: 24rpx 0;
  text-align: center;
  color: #999;
  font-size: 24rpx;
}
