/* ===== 个人中心样式 ===== */
.user {
  min-height: 100vh;
  background: #f7f7f7;
  padding-bottom: 60rpx;
}

/* 头部 */
.user__header {
  display: flex;
  align-items: center;
  padding: 60rpx 40rpx;
  background: linear-gradient(135deg, #07c160, #05a04e);
}
.user__avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #fff;
  flex-shrink: 0;
}
.user__avatar--placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  color: #07c160;
}
.user__info {
  margin-left: 24rpx;
}
.user__nickname-row {
  display: flex;
  align-items: center;
}
.user__nickname {
  font-size: 34rpx;
  font-weight: 600;
  color: #fff;
}
.user__edit-icon {
  margin-left: 12rpx;
  font-size: 28rpx;
}
.user__sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 订单快捷入口 */
.user__orders {
  margin: -40rpx 24rpx 0;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  position: relative;
  z-index: 1;
}
.user__orders-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.user__orders-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}
.user__orders-more {
  font-size: 24rpx;
  color: #999;
}
.user__orders-grid {
  display: flex;
  margin-top: 24rpx;
}
.user__orders-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.user__orders-icon {
  font-size: 48rpx;
}
.user__orders-label {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #666;
}

/* 功能菜单 */
.user__menu {
  margin: 20rpx 24rpx 0;
  background: #fff;
  border-radius: 16rpx;
}
.user__menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #f2f2f2;
}
.user__menu-item:last-child {
  border-bottom: none;
}
.user__menu-item text:first-child {
  font-size: 36rpx;
}
.user__menu-name {
  flex: 1;
  margin-left: 20rpx;
  font-size: 28rpx;
  color: #333;
}
.user__menu-arrow {
  color: #ccc;
  font-size: 32rpx;
}
